# Copy this file to .env and fill in your real values
# NEVER commit .env to git or upload it online

# MongoDB Atlas (Required)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/globalpriceengine?appName=Cluster0

# JWT Secret (Required - generate a long random string)
JWT_SECRET=your-super-long-random-secret-key-here-min-32-chars

# Server
PORT=3000
NODE_ENV=production

# SerpAPI (Get free key at https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Optional APIs (leave blank if not using)
RAPIDAPI_KEY=
EBAY_APP_ID=
WALMART_API_KEY=
BESTBUY_API_KEY=
AMAZON_ACCESS_KEY=
AMAZON_ASSOCIATE_TAG=

# Stripe (for premium subscriptions)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (for price alerts)
EMAIL_USER=
EMAIL_PASS=
